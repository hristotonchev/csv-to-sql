{
  "name": "dev/csv-to-sql",
  "description": "Symfony Console app that converts CSV files to SQL CREATE TABLE statements",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "symfony/console": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/config": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10",
    "symfony/phpunit-bridge": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "phpstan": "vendor/bin/phpstan analyse src tests --level=8",
    "lint": "find src tests -name '*.php' | xargs php -l"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3"
    }
  }
}